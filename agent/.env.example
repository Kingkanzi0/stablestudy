# ── Where the agent works ──────────────────────────────
SKILLPAY_API_URL=https://skillpay-api-gc6o.onrender.com/api
# Same value as AGENT_API_KEY in the backend (Render → Environment)
AGENT_API_KEY=
ARC_NETWORK=testnet
# Optional: your own Arc RPC URL
# RPC_URL=
ESCROW_ADDRESS=

# ── The agent's wallet ─────────────────────────────────
# circle = Circle Agent Wallet via the Circle CLI (recommended; run `circle wallet login --testnet` first)
# key    = a local private key (only for local testing)
SIGNER=circle
# Your agent wallet address (`circle wallet list --type agent --chain ARC-TESTNET`)
AGENT_ADDRESS=
# Only for SIGNER=key
# AGENT_PRIVATE_KEY=

# ── The judge ──────────────────────────────────────────
# claude = review with Claude (needs ANTHROPIC_API_KEY); mock = approve unless notes say REJECT (testing only)
JUDGE=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Behaviour ──────────────────────────────────────────
POLL_INTERVAL_MS=30000
# true = write reports but never sign on-chain
DRY_RUN=false
