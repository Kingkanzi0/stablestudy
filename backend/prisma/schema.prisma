// SkillPay database schema.
// The blockchain is the source of truth for prices, ownership and enrolments.
// This database stores off-chain metadata (titles, lessons, profiles) and an
// index of on-chain events so the app can load quickly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tutor {
  /// Lower-case wallet address
  address     String   @id
  displayName String
  headline    String?
  bio         String?
  avatarUrl   String?
  website     String?
  /// Mirrors on-chain state, kept up to date by the indexer
  registered  Boolean  @default(false)
  suspended   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses Course[]
}

model Course {
  /// Metadata id. The on-chain metadataURI points at /api/metadata/courses/:id
  id              String       @id @default(cuid())
  /// Id assigned by the SkillPay contract once the course is published on-chain
  onchainId       Int?         @unique
  tutorAddress    String
  tutor           Tutor        @relation(fields: [tutorAddress], references: [address])
  title           String
  summary         String
  description     String
  category        String
  level           String
  durationMinutes Int?
  coverColor      String?
  /// DRAFT until the CourseCreated event is seen on-chain, then PUBLISHED
  status          String       @default("DRAFT")
  /// Price in USDC base units (6 decimals), mirrored from chain
  priceUnits      String?
  active          Boolean      @default(false)
  enrollmentCount Int          @default(0)
  createdTx       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  lessons     Lesson[]
  enrollments Enrollment[]

  @@index([tutorAddress])
  @@index([status, active])
}

model Lesson {
  id         String  @id @default(cuid())
  courseId   String
  course     Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  position   Int
  title      String
  /// Markdown/plain text, only served to enrolled students and the tutor
  content    String
  videoUrl   String?
  resourceUrl String?

  @@unique([courseId, position])
}

model Enrollment {
  id           String   @id @default(cuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id])
  onchainId    Int
  /// Lower-case wallet address
  student      String
  txHash       String
  logIndex     Int
  blockNumber  Int
  priceUnits   String
  feeUnits     String
  tutorUnits   String
  createdAt    DateTime @default(now())

  @@unique([onchainId, student])
  @@unique([txHash, logIndex])
  @@index([student])
}

model AuthNonce {
  nonce     String   @id
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model IndexerState {
  id        Int      @id @default(1)
  lastBlock BigInt
  updatedAt DateTime @updatedAt
}

/// Web3 job listings. Off-chain; posted by a signed-in wallet.
model Job {
  id            String   @id @default(cuid())
  /// Lower-case wallet address of whoever posted it
  posterAddress String
  title         String
  company       String
  companyUrl    String?
  location      String
  type          String
  category      String
  /// Pay range in whole USDC, optional
  payMin        Int?
  payMax        Int?
  /// "hour" | "month" | "year" | "project"
  payUnit       String?
  description   String
  /// https:// link or mailto: address
  applyUrl      String
  tags          String[] @default([])
  /// OPEN | CLOSED
  status        String   @default("OPEN")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, createdAt])
  @@index([posterAddress])
}
