// SkillPay database schema.
// The blockchain is the source of truth for prices, ownership and enrolments.
// This database stores off-chain metadata (titles, lessons, profiles) and an
// index of on-chain events so the app can load quickly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tutor {
  /// Lower-case wallet address
  address     String   @id
  displayName String
  headline    String?
  bio         String?
  avatarUrl   String?
  website     String?
  /// Mirrors on-chain state, kept up to date by the indexer
  registered  Boolean  @default(false)
  suspended   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses Course[]
}

model Course {
  /// Metadata id. The on-chain metadataURI points at /api/metadata/courses/:id
  id              String       @id @default(cuid())
  /// Id assigned by the SkillPay contract once the course is published on-chain
  onchainId       Int?         @unique
  tutorAddress    String
  tutor           Tutor        @relation(fields: [tutorAddress], references: [address])
  title           String
  summary         String
  description     String
  category        String
  level           String
  durationMinutes Int?
  coverColor      String?
  /// DRAFT until the CourseCreated event is seen on-chain, then PUBLISHED
  status          String       @default("DRAFT")
  /// Price in USDC base units (6 decimals), mirrored from chain
  priceUnits      String?
  active          Boolean      @default(false)
  enrollmentCount Int          @default(0)
  createdTx       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  lessons     Lesson[]
  enrollments Enrollment[]

  @@index([tutorAddress])
  @@index([status, active])
}

model Lesson {
  id         String  @id @default(cuid())
  courseId   String
  course     Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  position   Int
  title      String
  /// Markdown/plain text, only served to enrolled students and the tutor
  content    String
  videoUrl   String?
  resourceUrl String?

  @@unique([courseId, position])
}

model Enrollment {
  id           String   @id @default(cuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id])
  onchainId    Int
  /// Lower-case wallet address
  student      String
  txHash       String
  logIndex     Int
  blockNumber  Int
  priceUnits   String
  feeUnits     String
  tutorUnits   String
  createdAt    DateTime @default(now())

  @@unique([onchainId, student])
  @@unique([txHash, logIndex])
  @@index([student])
}

model AuthNonce {
  nonce     String   @id
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model IndexerState {
  id        Int      @id @default(1)
  lastBlock BigInt
  updatedAt DateTime @updatedAt
}

/// Web3 job listings. Off-chain; posted by a signed-in wallet.
model Job {
  id            String   @id @default(cuid())
  /// Lower-case wallet address of whoever posted it
  posterAddress String
  title         String
  company       String
  companyUrl    String?
  location      String
  type          String
  category      String
  /// Pay range in whole USDC, optional
  payMin        Int?
  payMax        Int?
  /// "hour" | "month" | "year" | "project"
  payUnit       String?
  description   String
  /// https:// link or mailto: address
  applyUrl      String
  tags          String[] @default([])
  /// OPEN | CLOSED
  status        String   @default("OPEN")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, createdAt])
  @@index([posterAddress])
}

/// A service paid through the SkillPayEscrow contract. Starts as an off-chain DRAFT holding the spec;
/// becomes FUNDED once the client's createOrder transaction is indexed.
model Order {
  id              String         @id @default(cuid())
  /// Id assigned by the escrow contract
  onchainId       Int?           @unique
  clientAddress   String
  providerAddress String
  title           String
  description     String
  /// Acceptance criteria the verifier agent checks, one per entry
  criteria        String[]
  category        String
  amountUnits     String
  deadline        DateTime
  /// keccak256 of the canonical spec JSON (specJson), committed on-chain
  specHash        String         @unique
  specJson        String
  /// DRAFT FUNDED ACCEPTED DELIVERED REJECTED DISPUTED RELEASED REFUNDED CANCELLED RESOLVED
  status          String         @default("DRAFT")
  verifierAddress String?
  reviewEnds      DateTime?
  feeBps          Int?
  createdTx       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  deliveries Delivery[]
  verdicts   Verdict[]
  events     OrderEvent[]

  @@index([clientAddress])
  @@index([providerAddress])
  @@index([status])
}

model Delivery {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  url          String
  notes        String
  /// keccak256 of the canonical delivery JSON (recordJson), committed on-chain
  deliveryHash String   @unique
  recordJson   String
  /// Set once DeliverySubmitted is indexed
  number       Int?
  submittedTx  String?
  createdAt    DateTime @default(now())

  @@index([orderId])
}

/// The verifier agent's written report. Its hash is what the agent signs on-chain.
model Verdict {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryNumber Int
  approved       Boolean
  summary        String
  /// [{ criterion, met, note }]
  checks         Json
  model          String?
  reasonHash     String   @unique
  reportJson     String
  txHash         String?
  createdAt      DateTime @default(now())

  @@index([orderId])
}

/// On-chain escrow events, for the order timeline.
model OrderEvent {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type        String
  data        Json
  txHash      String
  logIndex    Int
  blockNumber Int
  createdAt   DateTime @default(now())

  @@unique([txHash, logIndex])
  @@index([orderId])
}
