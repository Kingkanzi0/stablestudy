# ── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=5001
# Public URL of this API. Course metadata URIs stored on-chain point here,
# so set it to your real domain BEFORE tutors publish courses on mainnet.
PUBLIC_API_URL=http://localhost:5001
# Frontend origin(s) allowed to call the API and sign in (comma separated)
CLIENT_URL=http://localhost:5173

# ── Database (PostgreSQL) ──────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skillpay

# ── Auth ───────────────────────────────────────────────
# Long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# ── Chain ──────────────────────────────────────────────
# mainnet | testnet | local
ARC_NETWORK=testnet
# Optional: override the RPC (e.g. Alchemy / QuickNode URL with your key)
# RPC_URL=
# Address printed by the deploy script
SKILLPAY_ADDRESS=0x0000000000000000000000000000000000000000
# Block the contract was deployed in (printed by the deploy script). Speeds up indexing.
START_BLOCK=0

# ── Indexer ────────────────────────────────────────────
INDEXER_ENABLED=true
INDEXER_INTERVAL_MS=5000
INDEXER_BLOCK_RANGE=5000

# ── Escrow + verifier agent ────────────────────────────
# SkillPayEscrow address and its deployment block (leave empty until deployed)
ESCROW_ADDRESS=
ESCROW_START_BLOCK=0
# Long random secret shared with the verifier agent (openssl rand -hex 32)
AGENT_API_KEY=
