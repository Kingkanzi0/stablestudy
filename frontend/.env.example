# mainnet | testnet | local
VITE_ARC_NETWORK=testnet
# SkillPay contract address (printed by contracts/script/Deploy.s.sol)
VITE_SKILLPAY_ADDRESS=0x0000000000000000000000000000000000000000
# Backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:5001/api
# Optional: your own RPC URL (Alchemy/QuickNode) for better reliability
# VITE_RPC_URL=
# Local Anvil only: address of the mock USDC you deployed
# VITE_LOCAL_USDC_ADDRESS=
# SkillPayEscrow address (leave empty until deployed)
VITE_ESCROW_ADDRESS=
